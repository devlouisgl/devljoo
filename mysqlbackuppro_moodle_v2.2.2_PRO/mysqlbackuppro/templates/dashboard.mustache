<div class="mbpro-wrap">
    <h2>{{#str}}dashboard, local_mysqlbackuppro{{/str}}</h2>

    <div class="mbpro-grid">
        <div class="mbpro-card mbpro-card-blue">
            <i class="fa fa-database mbpro-icon"></i>
            <div>
                <h3>{{stats.total_backups}}</h3>
                <p>{{#str}}total_backups, local_mysqlbackuppro{{/str}}</p>
            </div>
        </div>
        <div class="mbpro-card mbpro-card-green">
            <i class="fa fa-check-circle mbpro-icon"></i>
            <div>
                <h3>{{stats.successful}}</h3>
                <p>{{#str}}successful, local_mysqlbackuppro{{/str}}</p>
            </div>
        </div>
        <div class="mbpro-card mbpro-card-red">
            <i class="fa fa-exclamation-triangle mbpro-icon"></i>
            <div>
                <h3>{{stats.failed}}</h3>
                <p>{{#str}}failed, local_mysqlbackuppro{{/str}}</p>
            </div>
        </div>
        <div class="mbpro-card mbpro-card-orange">
            <i class="fa fa-file-archive-o mbpro-icon"></i>
            <div>
                <h3>{{stats.total_size}}</h3>
                <p>{{#str}}total_size, local_mysqlbackuppro{{/str}}</p>
            </div>
        </div>
    </div>

    <div class="mbpro-section">
        <h3>{{#str}}db_info, local_mysqlbackuppro{{/str}}</h3>
        <table class="generaltable mbpro-table">
            <tr><th width="200">{{#str}}db_name, local_mysqlbackuppro{{/str}}</th><td><code>{{stats.db_name}}</code></td></tr>
            <tr><th>{{#str}}db_size, local_mysqlbackuppro{{/str}}</th><td>{{stats.db_size}}</td></tr>
            <tr><th>{{#str}}tables, local_mysqlbackuppro{{/str}}</th><td>{{stats.table_count}}</td></tr>
            <tr><th>{{#str}}next_backup, local_mysqlbackuppro{{/str}}</th><td>{{stats.next_backup}}</td></tr>
            <tr><th>{{#str}}auto_backups, local_mysqlbackuppro{{/str}}</th>
                <td>
                    {{#stats.enabled}}
                        <span class="mbpro-badge mbpro-badge-green">{{#str}}enabled, local_mysqlbackuppro{{/str}}</span>
                    {{/stats.enabled}}
                    {{^stats.enabled}}
                        <span class="mbpro-badge mbpro-badge-red">{{#str}}disabled, local_mysqlbackuppro{{/str}}</span>
                    {{/stats.enabled}}
                </td>
            </tr>
            <tr><th>{{#str}}frequency, local_mysqlbackuppro{{/str}}</th><td>{{stats.frequency}}</td></tr>
            <tr><th>{{#str}}s3_status, local_mysqlbackuppro{{/str}}</th>
                <td>
                    {{#stats.s3_configured}}
                        <span class="mbpro-badge mbpro-badge-green">{{#str}}configured, local_mysqlbackuppro{{/str}}</span> ({{stats.s3_bucket}})
                    {{/stats.s3_configured}}
                    {{^stats.s3_configured}}
                        <span class="mbpro-badge mbpro-badge-gray">{{#str}}not_configured, local_mysqlbackuppro{{/str}}</span>
                    {{/stats.s3_configured}}
                </td>
            </tr>
        </table>
    </div>

    {{#last_backup}}
    <div class="mbpro-section">
        <h3>{{#str}}last_backup, local_mysqlbackuppro{{/str}}</h3>
        <table class="generaltable mbpro-table">
            <tr><th width="200">{{#str}}file, local_mysqlbackuppro{{/str}}</th><td><code>{{last_backup.file_name}}</code></td></tr>
            <tr><th>{{#str}}size, local_mysqlbackuppro{{/str}}</th><td>{{last_backup.file_size}}</td></tr>
            <tr><th>{{#str}}status, local_mysqlbackuppro{{/str}}</th>
                <td>
                    {{#last_backup.status_ok}}
                        <span class="mbpro-badge mbpro-badge-green">OK</span>
                    {{/last_backup.status_ok}}
                    {{^last_backup.status_ok}}
                        <span class="mbpro-badge mbpro-badge-red">{{last_backup.status}}</span>
                    {{/last_backup.status_ok}}
                </td>
            </tr>
            <tr><th>{{#str}}date, local_mysqlbackuppro{{/str}}</th><td>{{last_backup.completed_at}}</td></tr>
            {{#last_backup.has_s3}}
            <tr><th>S3</th>
                <td><span class="mbpro-s3-badge mbpro-s3-yes"><i class="fa fa-cloud"></i> {{#str}}uploaded_s3, local_mysqlbackuppro{{/str}}</span></td>
            </tr>
            {{/last_backup.has_s3}}
        </table>
    </div>
    {{/last_backup}}
    {{^last_backup}}
    <div class="mbpro-section">
        <h3>{{#str}}last_backup, local_mysqlbackuppro{{/str}}</h3>
        <p class="mbpro-empty">{{#str}}no_backups_yet, local_mysqlbackuppro{{/str}}</p>
    </div>
    {{/last_backup}}

    <div class="mbpro-section">
        <h3>{{#str}}quick_actions, local_mysqlbackuppro{{/str}}</h3>
        <div class="mbpro-actions-bar">
            <button id="mbpro-run-backup" class="btn btn-primary">
                <i class="fa fa-play"></i> {{#str}}run_backup_now, local_mysqlbackuppro{{/str}}
            </button>
            <a href="{{config.wwwroot}}/local/mysqlbackuppro/index.php?page=settings" class="btn btn-secondary">
                <i class="fa fa-cog"></i> {{#str}}settings, local_mysqlbackuppro{{/str}}
            </a>
            <a href="{{config.wwwroot}}/local/mysqlbackuppro/index.php?page=s3" class="btn btn-secondary">
                <i class="fa fa-cloud"></i> {{#str}}s3explorer, local_mysqlbackuppro{{/str}}
            </a>
            <a href="{{config.wwwroot}}/local/mysqlbackuppro/index.php?page=backups" class="btn btn-secondary">
                <i class="fa fa-list"></i> {{#str}}view_backups, local_mysqlbackuppro{{/str}}
            </a>
        </div>
    </div>
</div>

{{> local_mysqlbackuppro/modal }}
