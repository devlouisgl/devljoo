<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/mysqlbackuppro/db" VERSION="20240609" COMMENT="MySQL Backup Pro tables">
    <TABLES>
        <TABLE NAME="local_mbpro_backups" COMMENT="Historial de backups realizados">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" COMMENT="ID unico del backup"/>
                <FIELD NAME="file_name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Nombre del archivo de backup"/>
                <FIELD NAME="file_path" TYPE="char" LENGTH="500" NOTNULL="false" SEQUENCE="false" COMMENT="Ruta local absoluta del archivo"/>
                <FIELD NAME="s3_key" TYPE="char" LENGTH="500" NOTNULL="false" SEQUENCE="false" COMMENT="Ruta (key) del archivo en S3"/>
                <FIELD NAME="s3_bucket" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Nombre del bucket S3"/>
                <FIELD NAME="s3_endpoint" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Endpoint S3 utilizado"/>
                <FIELD NAME="file_size" TYPE="int" LENGTH="20" NOTNULL="false" DEFAULT="0" UNSIGNED="false" SEQUENCE="false" COMMENT="Tamano del archivo en bytes"/>
                <FIELD NAME="tables_list" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Lista de tablas incluidas en el backup (JSON)"/>
                <FIELD NAME="rows_count" TYPE="int" LENGTH="20" NOTNULL="false" DEFAULT="0" UNSIGNED="false" SEQUENCE="false" COMMENT="Numero total de filas respaldadas"/>
                <FIELD NAME="status" TYPE="char" LENGTH="50" NOTNULL="false" DEFAULT="pending" SEQUENCE="false" COMMENT="Estado del backup"/>
                <FIELD NAME="backup_type" TYPE="char" LENGTH="50" NOTNULL="false" DEFAULT="manual" SEQUENCE="false" COMMENT="Tipo de backup: manual o scheduled"/>
                <FIELD NAME="error_msg" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Mensaje de error en caso de fallo"/>
                <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="false" COMMENT="Timestamp de creacion"/>
                <FIELD NAME="completed_at" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" COMMENT="Timestamp de finalizacion"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
                <INDEX NAME="created_idx" UNIQUE="false" FIELDS="created_at"/>
                <INDEX NAME="type_idx" UNIQUE="false" FIELDS="backup_type"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
