<div class="mbpro-wrap mbpro-s3-explorer">
    <h2>
        <i class="fa fa-cloud"></i> {{#str}}s3explorer, local_mysqlbackuppro{{/str}}
        {{#s3_configured}}
            <span class="mbpro-badge mbpro-badge-green" style="font-size:0.6em;vertical-align:middle;margin-left:8px;">
                {{s3_bucket}} @ {{s3_host}}
            </span>
        {{/s3_configured}}
    </h2>

    {{^s3_configured}}
    <div class="alert alert-danger">
        <strong>{{#str}}s3_not_configured, local_mysqlbackuppro{{/str}}</strong>
        {{#str}}s3_go_settings, local_mysqlbackuppro{{/str}}
        <a href="{{config.wwwroot}}/local/mysqlbackuppro/index.php?page=settings">{{#str}}settings, local_mysqlbackuppro{{/str}}</a>.
    </div>
    {{/s3_configured}}

    {{#s3_configured}}
    <!-- Toolbar -->
    <div class="mbpro-s3-toolbar">
        <div class="mbpro-s3-toolbar-row">
            <div class="mbpro-s3-breadcrumb" id="mbpro-s3-breadcrumb">
                <button class="btn btn-sm btn-secondary mbpro-s3-nav-root" data-prefix="">
                    <i class="fa fa-cloud"></i> {{#str}}root, local_mysqlbackuppro{{/str}}
                </button>
                <span id="mbpro-s3-breadcrumb-path"></span>
            </div>
            <div class="mbpro-s3-actions">
                <button id="mbpro-s3-create-folder-btn" class="btn btn-secondary">
                    <i class="fa fa-plus"></i> {{#str}}new_folder, local_mysqlbackuppro{{/str}}
                </button>
                <button id="mbpro-s3-refresh" class="btn btn-secondary">
                    <i class="fa fa-refresh"></i> {{#str}}refresh, local_mysqlbackuppro{{/str}}
                </button>
            </div>
        </div>
        <div class="mbpro-s3-toolbar-row mbpro-s3-toolbar-filters">
            <div class="mbpro-s3-search-box">
                <i class="fa fa-search mbpro-search-icon"></i>
                <input type="text" id="mbpro-s3-search" placeholder="{{#str}}search_files, local_mysqlbackuppro{{/str}}" class="form-control">
                <button id="mbpro-s3-search-clear" class="btn btn-sm btn-icon" title="{{#str}}clear, local_mysqlbackuppro{{/str}}" style="display:none;">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="mbpro-s3-filter-group">
                <select id="mbpro-s3-filter-ext" class="form-control">
                    <option value="">{{#str}}all_files, local_mysqlbackuppro{{/str}}</option>
                    <option value=".sql">SQL (.sql)</option>
                    <option value=".gz">Gzip (.gz)</option>
                    <option value=".zip">ZIP (.zip)</option>
                    <option value=".log">Log (.log)</option>
                    <option value=".txt">Text (.txt)</option>
                    <option value=".json">JSON (.json)</option>
                    <option value=".xml">XML (.xml)</option>
                </select>
                <select id="mbpro-s3-per-page" class="form-control">
                    <option value="25">25 {{#str}}per_page, local_mysqlbackuppro{{/str}}</option>
                    <option value="50" selected>50 {{#str}}per_page, local_mysqlbackuppro{{/str}}</option>
                    <option value="100">100 {{#str}}per_page, local_mysqlbackuppro{{/str}}</option>
                </select>
            </div>
        </div>
    </div>

    <div class="mbpro-s3-results-info" id="mbpro-s3-results-info" style="display:none;">
        <span id="mbpro-s3-results-text"></span>
        <span id="mbpro-s3-search-badge" class="mbpro-s3-search-badge" style="display:none;">
            <i class="fa fa-search"></i>
            {{#str}}searching, local_mysqlbackuppro{{/str}}: <strong id="mbpro-s3-search-term"></strong>
            <a href="#" id="mbpro-s3-clear-search-link">({{#str}}clear, local_mysqlbackuppro{{/str}})</a>
        </span>
    </div>

    <table class="generaltable mbpro-table" id="mbpro-s3-table">
        <thead>
            <tr>
                <th width="40"></th>
                <th>{{#str}}name, local_mysqlbackuppro{{/str}}</th>
                <th width="120">{{#str}}size, local_mysqlbackuppro{{/str}}</th>
                <th width="180">{{#str}}date, local_mysqlbackuppro{{/str}}</th>
                <th width="80">{{#str}}actions, local_mysqlbackuppro{{/str}}</th>
            </tr>
        </thead>
        <tbody id="mbpro-s3-tbody">
            <tr><td colspan="5" class="mbpro-empty">{{#str}}loading, local_mysqlbackuppro{{/str}}</td></tr>
        </tbody>
    </table>

    <div class="mbpro-s3-pagination" id="mbpro-s3-pagination" style="display:none;">
        <div class="mbpro-s3-pagination-info">
            <span id="mbpro-s3-page-info"></span>
        </div>
        <div class="mbpro-s3-pagination-controls">
            <button class="btn btn-sm btn-secondary" id="mbpro-s3-first-page" title="{{#str}}first_page, local_mysqlbackuppro{{/str}}">
                <i class="fa fa-step-backward"></i>
            </button>
            <button class="btn btn-sm btn-secondary" id="mbpro-s3-prev-page" title="{{#str}}prev_page, local_mysqlbackuppro{{/str}}">
                <i class="fa fa-chevron-left"></i>
            </button>
            <span class="mbpro-s3-page-number" id="mbpro-s3-current-page">1</span>
            <button class="btn btn-sm btn-secondary" id="mbpro-s3-next-page" title="{{#str}}next_page, local_mysqlbackuppro{{/str}}">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    </div>

    <div class="mbpro-s3-info">
        <i class="fa fa-info-circle"></i>
        {{#str}}s3_explorer_info, local_mysqlbackuppro{{/str}}
    </div>

    <!-- Create folder modal -->
    <div id="mbpro-s3-folder-modal" class="mbpro-modal" style="display:none;">
        <div class="mbpro-modal-bg"></div>
        <div class="mbpro-modal-box mbpro-modal-small">
            <h3>{{#str}}new_folder, local_mysqlbackuppro{{/str}}</h3>
            <p><input type="text" id="mbpro-s3-new-folder" class="form-control" placeholder="folder-name"></p>
            <p>
                <button id="mbpro-s3-folder-confirm" class="btn btn-primary">{{#str}}create, local_mysqlbackuppro{{/str}}</button>
                <button id="mbpro-s3-folder-cancel" class="btn btn-secondary">{{#str}}cancel, local_mysqlbackuppro{{/str}}</button>
            </p>
        </div>
    </div>
    {{/s3_configured}}
</div>
