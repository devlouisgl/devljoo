<div class="mbpro-wrap">
    <h2><i class="fa fa-file-text-o"></i> {{#str}}logs, local_mysqlbackuppro{{/str}}</h2>

    <div class="mbpro-actions-bar mbpro-mb-3">
        <select id="mbpro-log-filter" class="form-control" style="width:auto;display:inline-block;">
            <option value="all">{{#str}}all_levels, local_mysqlbackuppro{{/str}}</option>
            <option value="INFO">INFO</option>
            <option value="WARNING">WARNING</option>
            <option value="ERROR">ERROR</option>
        </select>
        <button id="mbpro-refresh-logs" class="btn btn-secondary">
            <i class="fa fa-refresh"></i> {{#str}}refresh, local_mysqlbackuppro{{/str}}
        </button>
        <button id="mbpro-clear-logs" class="btn btn-danger">
            <i class="fa fa-trash"></i> {{#str}}clear_logs, local_mysqlbackuppro{{/str}}
        </button>
    </div>

    <div class="mbpro-logs-wrapper">
        <table class="generaltable mbpro-table" id="mbpro-logs-table">
            <thead>
                <tr>
                    <th width="180">{{#str}}date, local_mysqlbackuppro{{/str}}</th>
                    <th width="100">{{#str}}level, local_mysqlbackuppro{{/str}}</th>
                    <th>{{#str}}message, local_mysqlbackuppro{{/str}}</th>
                </tr>
            </thead>
            <tbody id="mbpro-logs-tbody">
                <tr><td colspan="3" class="mbpro-empty">{{#str}}loading, local_mysqlbackuppro{{/str}}</td></tr>
            </tbody>
        </table>
    </div>
</div>
